# --- App ---
APP_NAME=NORA Data Extractor
ENV=development

# --- Storage backend for OUTPUT/job artifacts: local | s3 | supabase ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data
LOCAL_DATASET_DIR=./sample_datasets

# --- S3-compatible object storage (used if STORAGE_BACKEND=s3) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Supabase Storage (used if STORAGE_BACKEND=supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=nora-datasets

# --- Source dataset access via AGDFS ---
AGDFS_BASE_URL=https://agdfs.onrender.com

# --- Jobs / limits ---
TEMP_DIR=./tmp
MAX_UPLOAD_MB=200
MAX_AOI_AREA_KM2=5000000
JOB_STORE_PATH=./tmp/jobs.json
MAX_WORKERS=2

DATASET_REGISTRY_PATH=./data/datasets_registry.json

# Comma-separated list is not supported directly by pydantic-settings for list[str];
# set as a JSON array string instead, e.g.: CORS_ORIGINS=["https://your-frontend.app"]
CORS_ORIGINS=["*"]
